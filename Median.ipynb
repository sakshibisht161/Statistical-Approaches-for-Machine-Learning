   ],
   "source": [
    "x = [2,3,4,5,6,7]\n",
    "x.sort()\n",
    "n = len(x)\n",
    "if n % 2 ==0:\n",
    "  mid1 = n//2\n",
    "  mid2 = mid1-1\n",
    "  median = (x[mid1]+x[mid2])/2\n",
    "else:\n",
    "  mid1 = n//2\n",
    "  median = x[mid1]\n",
    "print(median)"
   ]

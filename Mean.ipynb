   "source": [
    "x = [1, 2, 3, 4]\n",
    "f = [2, 3, 4, 5]\n",
    "fx = 0\n",
    "for i in range(len(x)):\n",
    "  fx = fx+x[i]*f[i]\n",
    "\n",
    "mean = fx/sum(f)\n",
    "print(mean)"
   ]
